{
	"type": "minecraft:multi_action",
	"title": "Help",
	"external_title": "Help",
	"body": {
		"type": "minecraft:plain_message",
		"contents": "What would you like help with?",
		"width": 400
	},
	"pause": false,
	"after_action": "none",
	"columns": 1,
	"actions": [
		{
			"label": "Commands",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 2"
			}
		},
		{
			"label": "Rules",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 3"
			}
		},
		{
			"label": "Ranks",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 4"
			}
		},
		{
      "label": {"color":"dark_aqua","text": "Visit Our Website"},
      "action": {
        "type": "minecraft:open_url",
        "url": "https://www.pandamium.com/"
      }
    },
	{
      "label": {"color":"dark_aqua","text": "Join Our Discord"},
      "action": {
        "type": "minecraft:open_url",
        "url": "http://discord.pandamium.eu/"
      }
    }
	],
	"exit_action": {
						"label": {
							"translate": "gui.done"
						},
						"action": {
							"type": "minecraft:show_dialog",
							"dialog": "pandamium:options"
						}
					}
}
